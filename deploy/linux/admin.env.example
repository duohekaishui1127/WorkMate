# install.sh writes the real domain to /etc/workmate/admin.env.
WORKMATE_LISTEN=127.0.0.1:8090
WORKMATE_DATA_DIR=/var/lib/workmate
WORKMATE_PUBLIC_URL=https://pro.your-domain.com
WORKMATE_TRUSTED_PROXIES=127.0.0.1,::1
# Optional HTTPS release asset. Share https://your-domain/download to count clicks.
# WORKMATE_DOWNLOAD_URL=https://downloads.your-domain.com/WorkMate.zip
