[Unit]
Description=WorkMate purchase and license administration
After=network.target

[Service]
Type=simple
User=workmate
Group=workmate
WorkingDirectory=/var/lib/workmate
EnvironmentFile=/etc/workmate/admin.env
ExecStart=/opt/workmate/workmate-admin
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
StateDirectory=workmate
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/workmate

[Install]
WantedBy=multi-user.target
